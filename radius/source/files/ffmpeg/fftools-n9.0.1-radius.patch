diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index b394243..36320c5 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -202,6 +202,26 @@ static BOOL WINAPI CtrlHandler(DWORD fdwCtrlType)
     signal(sig, func)
 #endif
 
+#if FFT_IN_PROCESS
+/* Radius (FFTools), modified 2026-10-15: ffmpeg runs inside the app's process, so it must not
+ * replace the app's signal handlers or touch the terminal. Cancellation is requested through
+ * fft_ffmpeg_request_exit() below: the same flags as receiving SIGTERM twice (the app discards
+ * the unfinished output, so stop at once instead of finishing it). SIGPIPE stays ignored, as in
+ * the CLI, so that writing to a closed pipe returns EPIPE instead of ending the app. */
+void fft_ffmpeg_request_exit(void)
+{
+    received_sigterm = SIGTERM;
+    if (received_nb_signals < 2)
+        received_nb_signals = 2;
+}
+
+void term_init(void)
+{
+#ifdef SIGPIPE
+    signal(SIGPIPE, SIG_IGN);
+#endif
+}
+#else
 void term_init(void)
 {
 #if defined __linux__
@@ -249,6 +269,7 @@ void term_init(void)
     SetConsoleCtrlHandler((PHANDLER_ROUTINE) CtrlHandler, TRUE);
 #endif
 }
+#endif /* FFT_IN_PROCESS */
 
 /* read a key without blocking */
 static int read_key(void)
