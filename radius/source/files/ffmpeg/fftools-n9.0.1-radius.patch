 int exit_on_error     = 0;
 int abort_on_flags    = 0;
 int print_stats       = -1;
+#if FFT_IN_PROCESS
+/* Radius (FFTools), modified 2026-10-15: there is no terminal inside the app; behave as if
+ * -nostdin was always given (never read keys or ask before overwriting). */
+int stdin_interaction = 0;
+#else
 int stdin_interaction = 1;
+#endif
 float max_error_rate  = 2.0/3;
 char *filter_nbthreads;
 int filter_complex_nbthreads = 0;
